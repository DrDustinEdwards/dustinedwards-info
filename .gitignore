.DS_Store
.env
/node_modules/
*.tsbuildinfo

# React Router
/.react-router/
/build/

# Phage Hunters photo sources. Only the generated WebP is committed.
/public/phage-hunters/*.jpg

# Claude Code. settings.json is committed; the local override never is.
.claude/settings.local.json

# Cloudflare
#
# THE SPLIT, written here so the next session does not undo it:
#   wrangler.jsonc          ignored. It differs from the tracked example in
#                           exactly two values, the account-scoped resource ids
#                           (D1 database_id, KV namespace id). Portfolio rule,
#                           capsid/conventions.md "Public-repo hygiene".
#   wrangler.jsonc.example  TRACKED, and it is the real description of this
#                           Worker's bindings: same bindings, same compat date
#                           and flags, same durable object migrations,
#                           placeholder ids. postinstall copies it into place on
#                           a fresh clone (scripts/bootstrap-config.mjs).
#   .dev.vars               ignored, always. Secrets are `wrangler secret`.
#
# `npm run check:config` fails when the two drift apart, in EITHER direction,
# and fails when the example starts carrying a real id. Adding a binding to
# wrangler.jsonc means adding it to the example in the same commit.
.mf
.wrangler
.dev.vars*
# Generated from wrangler.jsonc by `wrangler types`, on every postinstall and
# every typecheck. A derived file that regenerates whenever the config changes.
worker-configuration.d.ts
wrangler.jsonc

# The admin session for check:browser, read by scripts/check-browser.mjs.
#
#   .admin-session          ignored. Holds a live Better Auth session cookie for
#                           the single admin. A credential, so it never lands in
#                           git; same footing as .dev.vars above.
#   .admin-session.example  TRACKED, and it is where the instructions live: the
#                           five clicks in Chrome, what to copy, what format.
#                           When the session expires that file is the thing to
#                           read, which is why it is committed and this is not.
#
# IGNORED rather than merely untracked, for the reason /og-samples/ is below:
# `npm run ship` refuses on any dirty tree, untracked files included, so an
# unignored session file would block every ship window until it was moved out of
# the repo by hand.
.admin-session

# The smoke credential for check:browser, read by scripts/check-browser.mjs via
# SMOKE_TOKEN_FILE. A bearer token, so it never lands in git, on the same
# footing as .dev.vars and .admin-session above. Minted with
# `node scripts/mint-smoke-token.mjs`; README.md carries the three places it
# then has to be set.
#
# IGNORED rather than merely untracked, for the .admin-session reason: ship
# refuses on any dirty tree, untracked files included.
.smoke-token

# Social card review renders, written by `build:og -- --out og-samples`.
# Untracked because the PNG bytes are not deterministic and are deliberately
# kept out of the gated artifact, and IGNORED rather than merely untracked
# because `npm run ship` refuses on any dirty tree, untracked files included:
# without this line every ship window needs the directory moved out of the repo
# by hand, which is what happened on 2026-08-14.
/og-samples/

!.dev.vars.example
!.env.example

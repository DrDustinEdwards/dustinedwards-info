/**
 * Wrangler configuration template for dustinedwards.info
 * Copy to wrangler.jsonc and fill in the real resource ids. The real file is
 * gitignored; secrets are set with `wrangler secret put`, never here.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dustinedwards",
	"compatibility_date": "2026-07-06",
	"main": "./workers/app.ts",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dustinedwards",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "APP_KV",
			"id": "00000000000000000000000000000000"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "dustinedwards-media"
		}
	],
	// Media thumbnails. The library derives every size from the one original in
	// R2 through this binding, so without it /media/<key>?w=<n> falls back to
	// serving the full-resolution original and says so in x-media-thumb.
	//
	// Account-scoped rather than zone-scoped, and that is why it is the binding
	// rather than the /cdn-cgi/image/ URL syntax: measured 2026-08-02, the URL
	// interface answers 404 with Cloudflare error 1042 on workers.dev, because
	// it needs a customer zone. Carries no id, so this line is complete as
	// written rather than a placeholder.
	"images": { "binding": "IMAGES" },
	// Ask mode (search Layer 2). Remove this block and Ask disappears cleanly:
	// classic search is D1 only and never waits on it. Instance binding rather
	// than ai_search_namespaces because there is exactly one instance.
	"ai_search": [
		{
			"binding": "AI_SEARCH",
			"instance_name": "dustinedwards"
		}
	],
	// Both Ask guards: the exact per-IP burst limit (one instance per IP) and
	// the exact daily spend ceiling (one instance, "global"). A Durable Object
	// rather than the `ratelimit` binding or a KV counter because neither of
	// those counts: measured across four runs, the binding refused 1, 2, 9 and
	// then 0 of twelve concurrent requests against a limit of five. Removing
	// this block DISABLES Ask rather than un-protecting it: an unprotected
	// metered endpoint must not serve.
	"durable_objects": {
		"bindings": [
			{
				"name": "ASK_BUDGET",
				"class_name": "AskBudget"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AskBudget"]
		}
	]
}

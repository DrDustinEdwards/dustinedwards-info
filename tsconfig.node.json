{
  "extends": "./tsconfig.json",
  // The shared markdown pipeline lives under app/ so the Worker can import it,
  // but the build scripts import it too, so this project must list it as well.
  "include": ["vite.config.ts", "scripts/**/*", "app/lib/content/**/*"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}

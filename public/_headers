# Written by scripts/build-headers-file.mjs from workers/security-headers.mjs (npm run build). Do not edit.
# Only /assets/* and /islands/* are immutable: every other static file sits at a stable path and keeps the default revalidation.
/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), sync-xhr=(self), usb=(), web-share=(), xr-spatial-tracking=(), clipboard-read=(), gamepad=(), hid=(), idle-detection=(), interest-cohort=(), serial=(), unload=(), clipboard-write=(self), screen-wake-lock=(self)
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-DNS-Prefetch-Control: off
  X-Frame-Options: deny
  X-Permitted-Cross-Domain-Policies: none
  tdm-reservation: 1

/*.html
  Content-Type: text/html; charset=utf-8

/*.css
  ! Cross-Origin-Resource-Policy
  Content-Type: text/css; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin

/*.js
  ! Cross-Origin-Resource-Policy
  Content-Type: text/javascript; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin

/*.mjs
  ! Cross-Origin-Resource-Policy
  Content-Type: text/javascript; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin

/*.txt
  Content-Type: text/plain; charset=utf-8

/*.xml
  Content-Type: application/xml; charset=utf-8

/*.svg
  ! Cross-Origin-Resource-Policy
  Content-Type: image/svg+xml; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin

/*.woff2
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/
  Content-Type: text/html; charset=utf-8

/*/
  Content-Type: text/html; charset=utf-8

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/islands/*
  Cache-Control: public, max-age=31536000, immutable

/diagrams/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/phage-hunters/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/dustin-edwards-og-image.png
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/dustin-edwards-logo.svg
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/dustin-edwards-logo-dark.svg
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

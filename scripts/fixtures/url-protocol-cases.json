  "frontmatterNote": "Frontmatter never passes through renderBody, so rehypeUrlProtocols cannot see it. These cases bind the SCHEMA instead. Findings B001 (further_reading) and B008 (cover). PERMANENT NEGATIVES: the blocked entries are the vulnerability, not examples.",
  "frontmatterCases": [
    {
      "label": "PERMANENT NEGATIVE further_reading javascript:",
      "field": "further_reading",
      "value": "javascript:alert(1)",
      "expect": "blocked"
    },
    {
      "label": "PERMANENT NEGATIVE further_reading data:",

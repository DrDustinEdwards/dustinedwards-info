{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/entry.*.tsx",
    "app/routes/**/*.tsx",
    "app/enhance/*.ts",
    "workers/*.ts",
    "scripts/*.mjs",
    "scripts/machine-readable/*.mjs",
    "test/**/*.test.mjs",
    "test/worker/**/*.test.ts",
    "scripts/lib/site-clone-loader*.mjs",
    "scripts/lib/site-fixture-runners/*.mjs"
  ],
  "project": [
    "app/**/*.{ts,tsx,mjs}",
    "workers/**/*.{ts,mjs}",
    "scripts/**/*.mjs",
    "test/**/*.{ts,mjs}"
  ],
  "ignore": [
    "mcp/**"
  ],
  "ignoreDependencies": [
    "cloudflare",
    "mermaid"
  ],
  "ignoreBinaries": [
    "netstat"
  ]
}

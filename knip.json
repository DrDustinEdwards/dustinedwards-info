{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/routes.ts",
    "app/root.tsx",
    "app/entry.*.tsx",
    "app/routes/**/*.tsx",
    "app/enhance/*.ts",
    "workers/*.ts",
    "scripts/*.mjs",
    "scripts/machine-readable/*.mjs",
    ".design-sync/*.mjs",
    ".design-sync/*.tsx",
    ".design-sync/previews/*.tsx",
    "test/**/*.test.mjs",
    "test/worker/**/*.test.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx,mjs}",
    "workers/**/*.{ts,mjs}",
    "scripts/**/*.mjs",
    "test/**/*.{ts,mjs}",
    ".design-sync/**/*.{ts,tsx,mjs}"
  ],
  "ignore": ["scratchpad/**"],
  "ignoreDependencies": [
    "cloudflare",
    "cloudflare:test",
    "cloudflare:workers",
    "virtual:enhance",
    "virtual:header-render",
    "virtual:react-router/server-build",
    "mermaid"
  ],
  "ignoreBinaries": ["netstat"],
  "ignoreUnresolved": ["\\+types/"]
}

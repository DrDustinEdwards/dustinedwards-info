# A version must be three days old before npm will resolve it: the local half
# of the cooldown the shared Renovate preset puts on its PRs, since most npm
# supply-chain attacks are caught and unpublished inside that window.
#
# Needs npm 11.15.0 or later (engines.npm). 11.10.0 added the option, but
# before 11.15.0 npm refused its own nested install for a git dependency
# (@dustinedwards/site-api) with "--min-release-age cannot be provided when
# using --before", so `npm ci` failed outright.
#
# `npm ci` installs the lockfile as written and is not held back. To take a
# release inside the window on purpose, such as one of Dustin's own packages
# the day it ships, pass --min-release-age=0 on that one install.
min-release-age=3

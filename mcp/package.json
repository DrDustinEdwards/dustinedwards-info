{
  "name": "dustinedwards-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Dustin Edwards Admin: the admin MCP server for dustinedwards.info, a wrapper over its operator API. Contains no policy.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc",
    "typecheck": "wrangler types -c wrangler.jsonc && tsc -b",
    "test": "node --import ./test/resolve-ts.mjs --test \"test/**/*.test.ts\"",
    "probe:captures": "node scripts/probe-report.mjs",
    "check:wrapper": "node scripts/check-wrapper.mjs",
    "check:wrapper:plant": "bash scripts/plant-violations.sh",
    "check:conformance": "devkit-conformance",
    "build": "wrangler deploy --dry-run -c wrangler.jsonc --outdir=dist"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.48.1",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.156.2",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/conformance": "0.2.0-alpha.12",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "allowScripts": {
    "core-js-pure": false,
    "esbuild": false,
    "workerd": false
  }
}

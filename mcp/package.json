{
  "name": "dustinedwards-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dustin Edwards Admin: the admin MCP server for dustinedwards.info, a wrapper over its operator API. Contains no policy.",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "wrangler types && tsc -b",
    "test": "node --experimental-transform-types --import ./test/resolve-ts.mjs --test \"test/**/*.test.ts\"",
    "probe:captures": "node scripts/probe-report.mjs",
    "check:wrapper": "node scripts/check-wrapper.mjs",
    "check:wrapper:plant": "bash scripts/plant-violations.sh",
    "check:conformance": "node scripts/check-conformance.mjs",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "devDependencies": {
    "@modelcontextprotocol/conformance": "^0.2.0-alpha.10",
    "typescript": "^6.0.3",
    "wrangler": "4.129.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.20.1",
    "zod": "^4.4.3"
  }
}

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dustinedwards-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",

	// global_fetch_strictly_public: required by workers-oauth-provider to fetch a
	//   Client ID Metadata Document. Measured 2026-07-30: claude.ai sends its
	//   client_id as a URL and never calls a registration endpoint, so CIMD is the
	//   path a real client actually takes.
	//
	// `nodejs_compat` IS GONE AND STILL IN FORCE. The MCP SDK needs it and gets
	// it: at a compatibility date of 2026-08-04 or later the runtime enables
	// both nodejs_compat and nodejs_compat_v2 by default, so naming one here is
	// a flag the runtime ignores and a reader takes for a decision. Turning
	// Node compatibility off at this date is `no_nodejs_compat`, not the
	// absence of the positive flag.
	"compatibility_flags": ["global_fetch_strictly_public"],

	"observability": { "enabled": true },

	// ONE PUBLIC ADDRESS. admin-mcp.dustinedwards.info is a Custom Domain on the
	// dustinedwards.info zone, created by the deploy itself, and workers.dev is
	// off, so there is one origin, one OAuth resource (PUBLIC_ORIGIN + /mcp) and
	// one sign-in callback. mcp.dustinedwards.info is Capsid's.
	"workers_dev": false,
	"routes": [{ "pattern": "admin-mcp.dustinedwards.info", "custom_domain": true }],

	// Non-secret. ACCESS_TEAM_DOMAIN is the Cloudflare Access team,
	// https://<team>.cloudflareaccess.com, the same team Capsid, Carrel and
	// Foxing Admin sign in through. ADMIN_EMAIL is the one email let in, as
	// Access verifies it at sign-in.
	//
	// SITE_ORIGIN is the URL the site Worker is addressed by over the SITE
	// binding; check:wrapper asserts it equals SITE_ORIGIN in app/lib/seo.ts.
	// PUBLIC_ORIGIN is this server's own origin, and every access token is bound
	// to PUBLIC_ORIGIN + /mcp (RFC 8707).
	// DCR_REDIRECT_URIS is the exact allowlist for dynamically registered
	// clients (rule 13), comma separated. Empty refuses every registration.
	// Gemini Enterprise's fixed callback is listed; Grok's is added once it is
	// measured (a refused registration names its URI in the Worker log).
	// AGENT_WRITE names the agent principals that may change the site; every
	// other agent key reads only. grok (the AGENT_KEY_GROK secret) writes, on
	// Dustin's instruction of 2026-10-10: Grok cannot complete OAuth (measured
	// 2026-09-07), so its key is its only door.
	"vars": {
		"SITE_ORIGIN": "https://dustinedwards.info",
		"PUBLIC_ORIGIN": "https://admin-mcp.dustinedwards.info",
		"ACCESS_TEAM_DOMAIN": "https://YOUR_TEAM.cloudflareaccess.com",
		"ADMIN_EMAIL": "admin@example.com",
		"DCR_REDIRECT_URIS": "https://vertexaisearch.cloud.google.com/oauth-redirect",
		"AGENT_WRITE": "grok"
	},

	// THE ONLY ROUTE TO THE SITE: a service binding to the dustinedwards
	// Worker, the same transport the watchdog uses. Still HTTP, still the
	// operator bearer, still the operator API's authentication and limiter.
	// Carries no account-scoped id, so this block is complete as written.
	"services": [{ "binding": "SITE", "service": "dustinedwards" }],

	// BINDINGS ARE AN ALLOWLIST, and check:wrapper derives its expectations from
	// this block. There is deliberately NO D1, NO R2, and no binding of any kind
	// that could reach the publish machinery: the only path to it is an HTTP
	// request over the SITE binding to /api/operator. Adding a binding here that touches app data
	// would break the wrapper's central guarantee, so the gate fails on one.
	"kv_namespaces": [
		{
			// Token and grant storage for workers-oauth-provider.
			"binding": "OAUTH_KV",
			"id": "YOUR_OAUTH_KV_ID"
		},
		{
			// Capture log for the client measurement probe.
			"binding": "PROBE_KV",
			"id": "YOUR_PROBE_KV_ID"
		}
	],

	// The wrapper's own rate limiter. A Durable Object with the SYNCHRONOUS SQLite
	// API, because that is the only mechanism measured on this account to actually
	// count: the GA ratelimit binding sheds load permissively, and a DO using
	// async storage.get then storage.put is not atomic across the await. See
	// src/rate-limit.ts for the numbers.
	"durable_objects": {
		"bindings": [
			{
				"name": "OPERATOR_RATE_LIMIT",
				"class_name": "OperatorRateLimit"
			},
			{
				// The append-only tool-call log, rule 12.4. src/audit-log.ts.
				"name": "TOOL_CALL_LOG",
				"class_name": "ToolCallLog"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["OperatorRateLimit"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ToolCallLog"]
		}
	]

	// Secrets, set with `wrangler secret put`, never committed:
	//   OPERATOR_TOKEN        the API leg. Same value as the dustinedwards
	//                         Worker's OPERATOR_TOKEN. Identifies WHAT this
	//                         Worker may do.
	//   ACCESS_SAAS_CLIENT_ID      the Access for SaaS (OIDC) app used for
	//                              sign-in, redirect URL PUBLIC_ORIGIN + /callback.
	//   ACCESS_SAAS_CLIENT_SECRET  ditto.
	//
	// The client leg (who is operating) and the API leg (what the wrapper may do)
	// are never the same value. A client-leg identity failure must read
	// differently from the API refusing an operation.
}

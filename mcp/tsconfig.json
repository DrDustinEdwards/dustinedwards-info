{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": [
      "./worker-configuration.d.ts"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "composite": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "worker-configuration.d.ts",
    "../app/lib/health/repair.mjs",
    "../app/lib/health/ask-converge.mjs"
  ]
}

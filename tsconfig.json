{
  "files": [],
  "references": [
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.cloudflare.json" }
  ],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    /*
     * A SCRIPT MAY IMPORT A `.ts` MODULE BY ITS REAL FILENAME.
     *
     * Node 24 strips types on the fly, so `scripts/ship.mjs` can import
     * `app/lib/seo.ts` directly and stop restating the site origin. Node's ESM
     * resolver needs the extension in the specifier and TypeScript refuses one
     * by default. Safe here because nothing in this repository emits: `noEmit`
     * is on below and both projects are typechecked, never compiled.
     */
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true
  }
}

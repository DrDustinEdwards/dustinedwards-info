{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "workers/**/*",
    "worker-configuration.d.ts",
    // The static asset manifest, imported by the media rebuild. A Worker cannot
    // list its own static assets (the assets binding has only `fetch()`), so the
    // list has to be handed to it at build time.
    "content/generated/assets.json"
  ],
  // The gitignored enhancement bundles under app/enhance/dist/ are minified
  // build product; with checkJs on, tsc would grade the minifier's output.
  // Their source is app/enhance/*.ts, which stays included above. The ?url
  // imports of the bundles resolve through env.d.ts's `*?url` declaration, so
  // nothing type-level needs the files themselves.
  "exclude": ["app/enhance/dist"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    /*
     * ON THE SERVING PLANE, and deliberately not in tsconfig.node.json.
     *
     * An out-of-range index read here reaches a reader: a 500, or worse, an
     * `undefined` that stringifies into a page. The same read in a gate
     * script throws during the run that exists to catch things, loudly, on
     * the author's machine and again in CI, before anything ships. The two
     * projects carry different risk, and scoping a rule by plane is the
     * pattern this repo already uses for the public payload ceiling and the
     * admin exemption in hard rule 9.
     *
     * Measured 2026-08-28, the day this landed, by turning the flag on for the
     * whole tree and counting what it reported: 91 sites here and 312 under
     * scripts/. The scripts half is BACKLOG rather than declared done, and it
     * is written here so the next reader does not read the absence as an
     * oversight. `noUnusedLocals` is on the ROOT config and covers both.
     */
    "noUncheckedIndexedAccess": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}

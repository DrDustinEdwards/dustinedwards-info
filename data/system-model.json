  "flows": [
    {
      "id": "job-life",
      "name": "A job's life",
      "description": "One job from the moment it is posted to the moment GitHub's record is checked against what its agent claimed.",
      "steps": [
        {
          "relationship": "capsid-worker--serves--capsid-agents",
          "toward": "capsid-worker",
          "text": "Posted: a session posts a job over MCP. The Worker checks the caller's grant, picks the model, signs the body and stores the job.",
          "lights": [
            "capsid-db"
          ]
        },
        {
          "relationship": "capsid-worker--serves--capsid-agents",
          "toward": "capsid-worker",
          "text": "Claimed: an agent claims it. The Worker verifies the body's signature first and records who holds the job.",
          "lights": [
            "capsid-db"
          ]
        },
        {
          "relationship": "capsid-worker--serves--capsid-agents",
          "toward": "capsid-worker",
          "text": "Worked: the agent works on one branch of one repo.",
          "lights": [
            "capsid-db"
          ]
        },
        {
          "relationship": "capsid-worker--serves--capsid-agents",
          "toward": "capsid-agents",
          "text": "Blocked: at a push, a deploy, a secret or a merge the agent stops. The job waits with the exact command a person or the signed policy must approve, and resume hands it back.",
          "lights": [
            "capsid-db"
          ]
        },
        {
          "relationship": "capsid-worker--writes--capsid-github",
          "toward": "capsid-github",
          "text": "Pull request: the pull request opens through Capsid's GitHub App, and CI runs on it."
        },
        {
          "relationship": "capsid-tick--writes--capsid-github",
          "toward": "capsid-github",
          "text": "Merged: the five-minute tick merges a pull request whose CI is green on its exact head under the signed auto-merge policy, or the session that opened it merges it on green."
        },
        {
          "relationship": "capsid-github--deploys--capsid-worker",
          "toward": "capsid-worker",
          "text": "Deployed: the merge to master runs CI on GitHub Actions, which deploys the Worker."
        },
        {
          "relationship": "capsid-github--watches--capsid-worker",
          "toward": "capsid-github",
          "text": "Verified: CI's live gate reads the Worker's /health and checks it reports the commit that was merged."
        },
        {
          "relationship": "capsid-worker--reads--capsid-github",
          "toward": "capsid-worker",
          "text": "Claims checked: when the job completes, the Worker reads the pull request, its commits and CI from GitHub and records each claim beside what GitHub says.",
          "lights": [
            "capsid-db"
          ]
        }
      ]
    },
    {
      "id": "nightly-backup",
      "name": "The nightly backup",
      "description": "Once a day the Worker copies the whole store to R2, keeps a graduated set of copies, trims old history only once a copy holds it, and the watcher checks that the copy kept off the account is fresh.",
      "steps": [
        {
          "relationship": "capsid-worker--writes--capsid-media",
          "toward": "capsid-media",
          "text": "Dumped: at 09:00 UTC a daily cron in the Worker dumps every table to R2 with d1-dump, one JSON file each plus the schema.",
          "lights": [
            "capsid-db"
          ]
        },
        {
          "relationship": "capsid-worker--writes--capsid-media",
          "toward": "capsid-media",
          "text": "Marked complete: a completion marker is written last, and only when the dumped tables match the ones the migrations create. A run without it is never counted as a backup.",
          "lights": [
            "capsid-db"
          ]
        },
        {
          "relationship": "capsid-worker--writes--capsid-media",
          "toward": "capsid-media",
          "text": "Mirrored: every document body is written beside the dump as plain markdown, one file per document.",
          "lights": [
            "capsid-db"
          ]
        },
        {
          "relationship": "capsid-worker--writes--capsid-media",
          "toward": "capsid-media",
          "text": "Pruned: the newest complete run of each of the last 14 days, 8 weeks and 6 months is kept, and every other run is deleted whole. The newest complete run is never deleted."
        },
        {
          "relationship": "capsid-worker--writes--capsid-db",
          "toward": "capsid-db",
          "text": "Trimmed: document versions older than 90 days and audit rows older than 180 are pruned, after the dump, so every pruned row is in a kept copy."
        },
        {
          "relationship": "capsid-worker--writes--capsid-kv",
          "toward": "capsid-kv",
          "text": "Stamped: the run records its success, and /health warns once that stamp is more than 26 hours old."
        },
        {
          "relationship": "capsid-tick--reads--capsid-github",
          "toward": "capsid-tick",
          "text": "Watched: every half hour the watcher reads the newest copy kept off the Cloudflare account and files a finding once it is more than 36 hours old."
        }
      ]
    },
    {
      "id": "carrel-publish",
      "name": "Publishing a post",
      "description": "A post goes from a private draft in Carrel to a live page on dustinedwards.info, through the one contract every site speaks, with the site deciding what may go live.",
      "steps": [
        {
          "relationship": "carrel-worker--writes--carrel-db",
          "toward": "carrel-db",
          "text": "Drafted: the writer works in Carrel's editor, which autosaves a working draft only that person can see."
        },
        {
          "relationship": "carrel-worker--reads--website-worker",
          "toward": "carrel-worker",
          "text": "Previewed: Carrel shows the site's own render of the draft in a sandbox, with the checks' flags and any reviewer's beside it."
        },
        {
          "relationship": "carrel-worker--publishes-to--website-worker",
          "toward": "website-worker",
          "text": "Saved: an Editor or the Owner saves the draft to the site, naming the version it replaces. The site refuses a stale one, so nobody overwrites a newer save.",
          "lights": [
            "website-db"
          ]
        },
        {
          "relationship": "carrel-worker--publishes-to--website-worker",
          "toward": "website-worker",
          "text": "Published: only the Owner publishes, and a first publish asks for confirmation. The site's own publish policy decides, so there is one authority.",
          "lights": [
            "website-db"
          ]
        },
        {
          "relationship": "carrel-worker--publishes-to--website-worker",
          "toward": "website-worker",
          "text": "Or by instruction: the Owner's AI session may publish through the MCP door, never while a flag is open. It sends no text, so only the saved version goes live, and Dustin is emailed an unpublish link.",
          "lights": [
            "website-db"
          ]
        },
        {
          "relationship": "carrel-worker--writes--carrel-db",
          "toward": "carrel-db",
          "text": "Recorded: Carrel indexes the live post, records who published it (an AI session by its client name) and clears the draft that was sent."
        },
        {
          "relationship": "carrel-cron--watches--website-worker",
          "toward": "carrel-cron",
          "text": "Watched: every 15 minutes Carrel runs site-api's conformance suite against the site and emails when its state changes."
        }
      ]
    }
  ],
  "counts": {
    "systems": 17,
    "public": 12,
